---
import ReachOutModal from './ReachOutModal.astro';
---
<section id="intro" class="snap-section relative flex h-[100svh] items-center justify-center overflow-hidden bg-bg px-6 py-24">
  <a href="#top" aria-label="Back to top" class="scroll-arrow scroll-arrow--up">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 14 12 8 18 14"></polyline>
    </svg>
  </a>

  <a href="#writing" aria-label="To writing" class="scroll-arrow scroll-arrow--down-intro">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 10 12 16 18 10"></polyline>
    </svg>
  </a>

  <div class="intro-text serif text-center text-ink">
    <p class="intro-group">I'm <span class="intro-name" data-secret-name>Cedrik</span>.</p>

    <p class="intro-group">
      I'm building <a href="https://hopper.so" target="_blank" rel="noopener" class="italic intro-link">Hopper</a>, the place creators<br/>
      teach, sell, and run their communities<br/>
      without hating the software.
    </p>

    <p class="intro-group">
      I write here about what that actually takes.<br/>
      The Hopper build in public.<br/>
      The AI tools I make to move faster.<br/>
      The side projects I build to learn by doing.
    </p>

    <p class="intro-group">
      Plants and aquariums, too,<br/>
      because closed systems teach you patience.<br/>
      Startups teach you the opposite.
    </p>

    <p class="intro-signoff italic">From Singapore, with love.</p>
    <p class="intro-colophon italic">Every line of this, written by AI.</p>

    <span class="intro-reachout-wrap">
      <button type="button" class="intro-reachout" data-reachout-open>
        Reach out
      </button>
      <span class="reachout-spark reachout-spark--1" aria-hidden="true">✨</span>
      <span class="reachout-spark reachout-spark--2" aria-hidden="true">✨</span>
      <span class="reachout-spark reachout-spark--3" aria-hidden="true">✨</span>
      <span class="reachout-spark reachout-spark--4" aria-hidden="true">✨</span>
    </span>

    <div class="intro-socials" aria-label="Social links">
      <a href="https://www.linkedin.com/in/cedriklim/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="https://www.instagram.com/cedriklim/" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <a href="https://github.com/cedrik-lim" target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
    </div>
  </div>

  <ReachOutModal />

  <div class="secret-player" data-secret-player hidden aria-hidden="true">
    <button type="button" class="secret-player-btn" data-secret-toggle aria-label="Pause">
      <svg class="secret-player-icon secret-player-icon--pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="6" y="5" width="4" height="14" rx="1"/>
        <rect x="14" y="5" width="4" height="14" rx="1"/>
      </svg>
      <svg class="secret-player-icon secret-player-icon--play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>
    <div class="secret-player-meta">
      <div class="secret-player-title">LP Liew Chant</div>
      <div class="secret-player-sub italic">on repeat · close to dismiss</div>
    </div>
    <button type="button" class="secret-player-close" data-secret-close aria-label="Close">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
    <audio data-secret-audio src="/audio/lp-liew-chant.m4a" loop preload="none"></audio>
  </div>
</section>

<script>
  const trigger = document.querySelector<HTMLElement>('[data-secret-name]');
  const player  = document.querySelector<HTMLElement>('[data-secret-player]');
  const audio   = document.querySelector<HTMLAudioElement>('[data-secret-audio]');
  const toggle  = document.querySelector<HTMLButtonElement>('[data-secret-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-secret-close]');

  if (trigger && player && audio && toggle && closeBtn) {
    let count = 0;
    let lastClick = 0;
    const RESET_MS = 2000;
    const NEEDED = 10;

    const openPlayer = () => {
      player.hidden = false;
      player.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => player.setAttribute('data-open', ''));
      audio.play().then(() => {
        toggle.setAttribute('aria-label', 'Pause');
        player.setAttribute('data-playing', '');
      }).catch(() => {
        toggle.setAttribute('aria-label', 'Play');
        player.removeAttribute('data-playing');
      });
    };

    const closePlayer = () => {
      audio.pause();
      audio.currentTime = 0;
      player.removeAttribute('data-open');
      player.removeAttribute('data-playing');
      setTimeout(() => {
        player.hidden = true;
        player.setAttribute('aria-hidden', 'true');
      }, 250);
      count = 0;
    };

    trigger.addEventListener('click', () => {
      const now = Date.now();
      if (now - lastClick > RESET_MS) count = 0;
      lastClick = now;
      count += 1;
      if (count >= NEEDED) {
        count = 0;
        openPlayer();
      }
    });

    toggle.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        toggle.setAttribute('aria-label', 'Pause');
        player.setAttribute('data-playing', '');
      } else {
        audio.pause();
        toggle.setAttribute('aria-label', 'Play');
        player.removeAttribute('data-playing');
      }
    });

    closeBtn.addEventListener('click', closePlayer);
  }
</script>

<style>
  .intro-text {
    font-weight: 400;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.45;
    letter-spacing: -0.005em;
    max-width: 880px;
  }
  .intro-group {
    margin: 0 0 1.5em;
  }
  .intro-group:last-of-type {
    margin-bottom: 2em;
  }
  .intro-signoff {
    margin: 0;
    font-size: 0.95em;
    opacity: 0.85;
  }
  .intro-colophon {
    margin: 0.5em 0 0;
    font-size: 0.7em;
    opacity: 0.45;
    letter-spacing: 0.01em;
  }
  .intro-reachout-wrap {
    position: relative;
    display: inline-block;
    margin-top: 1.8em;
  }
  .intro-reachout {
    position: relative;
    display: inline-block;
    padding: 11px 24px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-family: var(--font-serif);
    font-size: 15px;
    letter-spacing: 0.005em;
    cursor: pointer;
    z-index: 1;
    transition: background 0.25s ease, color 0.25s ease, transform 0.15s ease, border-color 0.25s ease;
  }
  .intro-reachout:hover {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .intro-reachout:active {
    transform: scale(0.98);
  }

  .reachout-spark {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    line-height: 1;
    user-select: none;
    will-change: transform, opacity;
    animation: spark-twinkle 2.8s ease-in-out infinite;
  }
  .reachout-spark--1 {
    font-size: 16px;
    top: -10px;
    left: -14px;
    animation-delay: 0s;
  }
  .reachout-spark--2 {
    font-size: 11px;
    top: -4px;
    right: -8px;
    animation-delay: 0.7s;
  }
  .reachout-spark--3 {
    font-size: 14px;
    bottom: -12px;
    right: 18%;
    animation-delay: 1.4s;
  }
  .reachout-spark--4 {
    font-size: 10px;
    bottom: -2px;
    left: -4px;
    animation-delay: 2.1s;
  }
  .intro-reachout-wrap:hover .reachout-spark {
    animation-duration: 1.4s;
  }
  @keyframes spark-twinkle {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    40%      { opacity: 0.9; transform: scale(1) rotate(90deg); }
    60%      { opacity: 0.7; transform: scale(0.95) rotate(135deg); }
    80%      { opacity: 0; transform: scale(0.3) rotate(180deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reachout-spark { animation: none; opacity: 0; }
  }

  .intro-socials {
    margin-top: 1.6em;
    display: flex;
    justify-content: center;
    gap: 22px;
  }
  .intro-socials a {
    color: var(--color-ink);
    opacity: 0.7;
    transition: opacity 0.25s ease;
    display: inline-flex;
  }
  .intro-socials a:hover { opacity: 1; }

  @media (max-width: 640px) {
    .intro-text br { display: none; }
    .intro-group { margin-bottom: 1.2em; }
  }
  .intro-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.05em;
    transition: opacity 0.25s ease;
  }
  .intro-link:hover { opacity: 0.6; }

  .intro-name {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .secret-player {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(12px);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 10px;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: 999px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.18), 0 2px 6px -2px rgba(0, 0, 0, 0.08);
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(.2,.8,.2,1);
    pointer-events: none;
  }
  .secret-player[data-open] {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .secret-player-btn {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: none;
    background: var(--color-ink);
    color: var(--color-bg);
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  .secret-player-btn:active { transform: scale(0.95); }
  .secret-player-icon { display: none; }
  .secret-player[data-playing] .secret-player-icon--pause { display: block; }
  .secret-player:not([data-playing]) .secret-player-icon--play { display: block; padding-left: 2px; }
  .secret-player-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    padding-right: 4px;
  }
  .secret-player-title {
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: -0.005em;
  }
  .secret-player-sub {
    font-family: var(--font-serif);
    font-size: 10.5px;
    opacity: 0.55;
    letter-spacing: 0.01em;
  }
  .secret-player-close {
    border: none;
    background: transparent;
    color: var(--color-ink);
    opacity: 0.45;
    cursor: pointer;
    padding: 6px;
    margin: -6px -2px -6px 0;
    border-radius: 999px;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .secret-player-close:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }

  .scroll-arrow--up,
  .scroll-arrow--down-intro {
    position: absolute;
    left: max(24px, env(safe-area-inset-left));
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-bg) 60%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .scroll-arrow--up { top: 50%; transform: translateY(-50%) translateY(-32px); }
  .scroll-arrow--down-intro { top: 50%; transform: translateY(-50%) translateY(32px); }
  .scroll-arrow--up:hover,
  .scroll-arrow--down-intro:hover {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .scroll-arrow--up svg,
  .scroll-arrow--down-intro svg {
    width: 16px;
    height: 16px;
  }
</style>
