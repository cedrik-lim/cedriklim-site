---
---
<aside class="newsfeed" data-newsfeed aria-label="Latest news">
  <header class="newsfeed-head" data-newsfeed-head>
    <span class="newsfeed-dot" aria-hidden="true"></span>
    <span class="newsfeed-title">Latest in AI</span>
    <button type="button" class="newsfeed-refresh" data-newsfeed-refresh aria-label="Refresh">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="23 4 23 10 17 10"/>
        <polyline points="1 20 1 14 7 14"/>
        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
      </svg>
    </button>
    <button type="button" class="newsfeed-toggle" data-newsfeed-toggle aria-label="Minimize" aria-expanded="true">
      <svg class="newsfeed-toggle-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </header>
  <ul class="newsfeed-list" data-newsfeed-list>
    <li class="newsfeed-state" data-newsfeed-state>Loading…</li>
  </ul>
</aside>

<style is:global>
  .newsfeed {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 340px;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: 14px;
    box-shadow: 0 18px 50px -16px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    color: var(--color-ink);
    font-family: var(--font-serif);
    animation: nf-slide 0.5s cubic-bezier(.2,.8,.2,1) 0.6s both;
  }
  @keyframes nf-slide {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .newsfeed-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 9px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    cursor: pointer;
    user-select: none;
  }
  .newsfeed-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ef476f;
    box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 60%, transparent);
    animation: nf-pulse 2s ease-out infinite;
  }
  @keyframes nf-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 60%, transparent); }
    70%  { box-shadow: 0 0 0 8px color-mix(in srgb, #ef476f 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 0%, transparent); }
  }
  .newsfeed-title {
    font-size: 12px;
    font-style: italic;
    letter-spacing: 0.02em;
    flex: 1;
    opacity: 0.7;
  }
  .newsfeed-refresh {
    border: none;
    background: transparent;
    color: var(--color-ink);
    opacity: 0.4;
    cursor: pointer;
    padding: 4px;
    margin: -4px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease, background 0.2s ease, transform 0.4s ease;
  }
  .newsfeed-refresh:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .newsfeed-refresh[data-spinning] svg {
    animation: nf-spin 0.8s linear infinite;
  }
  @keyframes nf-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .newsfeed-toggle {
    border: none;
    background: transparent;
    color: var(--color-ink);
    opacity: 0.4;
    cursor: pointer;
    padding: 4px;
    margin: -4px -4px -4px 0;
    border-radius: 6px;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .newsfeed-toggle:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .newsfeed-toggle-icon {
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1);
  }
  .newsfeed[data-collapsed] .newsfeed-toggle-icon {
    transform: rotate(180deg);
  }
  .newsfeed[data-collapsed] .newsfeed-head {
    border-bottom-color: transparent;
  }
  .newsfeed[data-collapsed] .newsfeed-list {
    display: none;
  }
  .newsfeed[data-collapsed] .newsfeed-refresh {
    display: none;
  }

  .newsfeed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: calc(8 * 68px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-ink) 18%, transparent) transparent;
  }
  .newsfeed-list > li + li .newsfeed-item {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 6%, transparent);
  }
  .newsfeed-list::-webkit-scrollbar { width: 6px; }
  .newsfeed-list::-webkit-scrollbar-track { background: transparent; }
  .newsfeed-list::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 999px;
  }
  .newsfeed-list::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-ink) 32%, transparent);
  }

  .newsfeed-state {
    padding: 16px 14px;
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    font-size: 12px;
    font-style: italic;
  }

  .newsfeed-item {
    display: flex;
    gap: 12px;
    padding: 12px 16px;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
  }
  .newsfeed-item:hover {
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }
  .newsfeed-thumb {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 7px;
    background: transparent;
    object-fit: cover;
    display: block;
    align-self: flex-start;
    margin-top: 2px;
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1);
  }
  .newsfeed-item:hover .newsfeed-thumb {
    transform: scale(1.04);
  }
  .newsfeed-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .newsfeed-text-title {
    font-size: 13.5px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .newsfeed-text-meta {
    font-size: 11px;
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
    font-style: italic;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .newsfeed-text-meta-sep {
    display: inline-block;
    width: 2px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .newsfeed { display: none; }
  }
</style>

<script>
  type Story = {
    title: string;
    url: string;
    domain: string;
    faviconUrl: string;
    createdAt: number; // unix seconds
  };

  const list    = document.querySelector<HTMLElement>('[data-newsfeed-list]');
  const refresh = document.querySelector<HTMLButtonElement>('[data-newsfeed-refresh]');
  const TARGET_COUNT = 30;
  // Keywords that must appear (case-insensitive) for a story to count as AI news.
  const AI_KEYWORDS = /\b(AI|A\.I\.|AGI|ASI|LLM|LLMs|GPT|GPTs|ChatGPT|Claude|Anthropic|OpenAI|Gemini|DeepMind|DeepSeek|Mistral|Llama|Grok|RAG|MCP|fine[- ]?tuning|machine learning|deep learning|neural network|transformer|diffusion|generative|inference|embedding|prompt(?: engineering)?|reasoning model|agentic?|copilot|tokenization|nvidia|cuda|hugging[- ]?face|stable diffusion|midjourney|sora|dall-?e)\b/i;

  // Only stories from these domains (or their subdomains) appear in the feed.
  const TRUSTED = new Set([
    // Major news
    'nytimes.com', 'wsj.com', 'ft.com', 'bloomberg.com', 'reuters.com',
    'bbc.com', 'bbc.co.uk', 'apnews.com', 'theguardian.com', 'economist.com',
    'washingtonpost.com', 'theatlantic.com', 'newyorker.com',
    // Tech press
    'techcrunch.com', 'theverge.com', 'arstechnica.com', 'wired.com',
    'cnbc.com', 'venturebeat.com', 'engadget.com', 'cnet.com', 'zdnet.com',
    '404media.co', 'platformer.news', 'stratechery.com', 'theinformation.com',
    'semafor.com', 'axios.com', 'vox.com',
    // AI labs and big-tech blogs
    'openai.com', 'anthropic.com', 'deepmind.google', 'deepmind.com',
    'blog.google', 'ai.google', 'research.google', 'ai.googleblog.com',
    'ai.meta.com', 'about.fb.com', 'microsoft.com', 'blogs.microsoft.com',
    'nvidia.com', 'blogs.nvidia.com', 'apple.com', 'machinelearning.apple.com',
    'huggingface.co',
    // Research
    'arxiv.org', 'nature.com', 'science.org', 'mit.edu', 'stanford.edu',
    'spectrum.ieee.org', 'distill.pub',
  ]);

  const isTrusted = (host: string) => {
    if (!host) return false;
    if (TRUSTED.has(host)) return true;
    for (const t of TRUSTED) if (host.endsWith('.' + t)) return true;
    return false;
  };

  const formatAge = (sec: number) => {
    const diff = Math.max(0, Date.now() / 1000 - sec);
    if (diff < 60) return 'just now';
    if (diff < 3600) return Math.round(diff / 60) + 'm ago';
    if (diff < 86400) return Math.round(diff / 3600) + 'h ago';
    return Math.round(diff / 86400) + 'd ago';
  };

  const setState = (text: string) => {
    if (!list) return;
    list.innerHTML = '';
    const li = document.createElement('li');
    li.className = 'newsfeed-state';
    li.textContent = text;
    list.appendChild(li);
  };

  const safeDomain = (raw: string) => {
    try { return new URL(raw).hostname.replace(/^www\./, ''); } catch { return ''; }
  };

  const renderItems = (items: Story[]) => {
    if (!list) return;
    list.innerHTML = '';
    if (!items.length) { setState('No news right now.'); return; }
    for (const item of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'newsfeed-item';
      a.href = item.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';

      const img = document.createElement('img');
      img.className = 'newsfeed-thumb';
      img.decoding = 'async';
      img.src = item.faviconUrl;
      img.alt = '';
      img.onerror = () => { img.style.visibility = 'hidden'; };
      a.appendChild(img);

      const text = document.createElement('div');
      text.className = 'newsfeed-text';
      const title = document.createElement('div');
      title.className = 'newsfeed-text-title';
      title.textContent = item.title;
      const meta = document.createElement('div');
      meta.className = 'newsfeed-text-meta';
      const metaDomain = document.createElement('span');
      metaDomain.textContent = item.domain;
      const metaSep = document.createElement('span');
      metaSep.className = 'newsfeed-text-meta-sep';
      const metaAge = document.createElement('span');
      metaAge.textContent = formatAge(item.createdAt);
      meta.append(metaDomain, metaSep, metaAge);
      text.append(title, meta);
      a.appendChild(text);

      li.appendChild(a);
      list.appendChild(li);
    }
  };

  const load = async () => {
    if (refresh) refresh.dataset.spinning = '';
    try {
      // Hacker News Algolia API — CORS-friendly, no auth.
      // search_by_date sorted by recency; query catches the major AI terms,
      // then we client-side filter to AI-related titles only.
      // Fire several queries in parallel for coverage (Algolia doesn't
      // support OR in a single query). Then merge + dedupe + client-side filter.
      const fetchQuery = (q: string) => fetch(
        `https://hn.algolia.com/api/v1/search_by_date?query=${encodeURIComponent(q)}&tags=story&hitsPerPage=100`,
        { cache: 'no-store' },
      ).then((r) => r.ok ? r.json() : { hits: [] });

      const responses = await Promise.all([
        fetchQuery('AI'),
        fetchQuery('LLM'),
        fetchQuery('OpenAI'),
        fetchQuery('Anthropic'),
        fetchQuery('GPT'),
      ]);
      const allHits = responses.flatMap((j: any) => j?.hits ?? []);

      const seen = new Set<string>();
      const items: Story[] = allHits
        .filter((h: any) => h?.title && AI_KEYWORDS.test(h.title))
        .map((h: any) => {
          const u = h.url || `https://news.ycombinator.com/item?id=${h.objectID}`;
          const host = safeDomain(u) || 'news.ycombinator.com';
          return {
            title: h.title as string,
            url: u,
            domain: host,
            faviconUrl: `https://www.google.com/s2/favicons?sz=64&domain=${host}`,
            createdAt: h.created_at_i ?? 0,
          } as Story;
        })
        .filter((s: Story) => isTrusted(s.domain))
        .sort((a: Story, b: Story) => b.createdAt - a.createdAt)
        .filter((s: Story) => {
          const key = s.url;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        })
        .slice(0, TARGET_COUNT);

      if (!items.length) { setState('No AI news right now.'); return; }
      renderItems(items);
    } catch (err) {
      console.error(err);
      setState('Could not load news.');
    } finally {
      if (refresh) delete refresh.dataset.spinning;
    }
  };

  load();
  refresh?.addEventListener('click', load);

  const feed   = document.querySelector<HTMLElement>('[data-newsfeed]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-newsfeed-toggle]');
  const STORAGE_KEY = 'newsfeed-collapsed';
  const setCollapsed = (collapsed: boolean) => {
    if (!feed || !toggle) return;
    if (collapsed) feed.setAttribute('data-collapsed', '');
    else feed.removeAttribute('data-collapsed');
    toggle.setAttribute('aria-expanded', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? 'Expand' : 'Minimize');
    try { localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch {}
  };
  try {
    if (localStorage.getItem(STORAGE_KEY) === '1') setCollapsed(true);
  } catch {}
  const head = document.querySelector<HTMLElement>('[data-newsfeed-head]');
  head?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-newsfeed-refresh]')) return;
    setCollapsed(!feed?.hasAttribute('data-collapsed'));
  });
</script>
