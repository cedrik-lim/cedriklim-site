---
---
<aside class="newsfeed" data-newsfeed aria-label="Latest news">
  <header class="newsfeed-head">
    <span class="newsfeed-dot" aria-hidden="true"></span>
    <span class="newsfeed-title">Latest news</span>
    <button type="button" class="newsfeed-refresh" data-newsfeed-refresh aria-label="Refresh">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="23 4 23 10 17 10"/>
        <polyline points="1 20 1 14 7 14"/>
        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
      </svg>
    </button>
  </header>
  <ul class="newsfeed-list" data-newsfeed-list>
    <li class="newsfeed-state" data-newsfeed-state>Loading…</li>
  </ul>
</aside>

<style>
  .newsfeed {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 340px;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: 14px;
    box-shadow: 0 18px 50px -16px color-mix(in srgb, var(--color-ink) 30%, transparent);
    overflow: hidden;
    color: var(--color-ink);
    font-family: var(--font-serif);
    animation: nf-slide 0.5s cubic-bezier(.2,.8,.2,1) 0.6s both;
  }
  @keyframes nf-slide {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .newsfeed-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 9px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .newsfeed-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ef476f;
    box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 60%, transparent);
    animation: nf-pulse 2s ease-out infinite;
  }
  @keyframes nf-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 60%, transparent); }
    70%  { box-shadow: 0 0 0 8px color-mix(in srgb, #ef476f 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, #ef476f 0%, transparent); }
  }
  .newsfeed-title {
    font-size: 12px;
    font-style: italic;
    letter-spacing: 0.02em;
    flex: 1;
    opacity: 0.7;
  }
  .newsfeed-refresh {
    border: none;
    background: transparent;
    color: var(--color-ink);
    opacity: 0.4;
    cursor: pointer;
    padding: 4px;
    margin: -4px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease, background 0.2s ease, transform 0.4s ease;
  }
  .newsfeed-refresh:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .newsfeed-refresh[data-spinning] svg {
    animation: nf-spin 0.8s linear infinite;
  }
  @keyframes nf-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .newsfeed-list {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    max-height: calc(8 * 72px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-ink) 18%, transparent) transparent;
  }
  .newsfeed-list::-webkit-scrollbar { width: 6px; }
  .newsfeed-list::-webkit-scrollbar-track { background: transparent; }
  .newsfeed-list::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 999px;
  }
  .newsfeed-list::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-ink) 32%, transparent);
  }

  .newsfeed-state {
    padding: 16px 14px;
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    font-size: 12px;
    font-style: italic;
  }

  .newsfeed-item {
    display: flex;
    gap: 10px;
    padding: 10px 14px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .newsfeed-item:hover {
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }
  .newsfeed-thumb {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    object-fit: contain;
    padding: 7px;
    display: block;
    align-self: center;
  }
  .newsfeed-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
  }
  .newsfeed-text-title {
    font-size: 13px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .newsfeed-text-meta {
    font-size: 11px;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 900px) {
    .newsfeed { display: none; }
  }
</style>

<script>
  type Story = { title: string; url: string; domain: string; faviconUrl: string };

  const list    = document.querySelector<HTMLElement>('[data-newsfeed-list]');
  const refresh = document.querySelector<HTMLButtonElement>('[data-newsfeed-refresh]');
  const TARGET_COUNT = 30;

  const setState = (text: string) => {
    if (!list) return;
    list.innerHTML = '';
    const li = document.createElement('li');
    li.className = 'newsfeed-state';
    li.textContent = text;
    list.appendChild(li);
  };

  const safeDomain = (raw: string) => {
    try { return new URL(raw).hostname.replace(/^www\./, ''); } catch { return ''; }
  };

  const renderItems = (items: Story[]) => {
    if (!list) return;
    list.innerHTML = '';
    if (!items.length) { setState('No news right now.'); return; }
    for (const item of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'newsfeed-item';
      a.href = item.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';

      const img = document.createElement('img');
      img.className = 'newsfeed-thumb';
      img.loading = 'lazy';
      img.referrerPolicy = 'no-referrer';
      img.src = item.faviconUrl;
      img.alt = '';
      img.onerror = () => { img.style.visibility = 'hidden'; };
      a.appendChild(img);

      const text = document.createElement('div');
      text.className = 'newsfeed-text';
      const title = document.createElement('div');
      title.className = 'newsfeed-text-title';
      title.textContent = item.title;
      const meta = document.createElement('div');
      meta.className = 'newsfeed-text-meta';
      meta.textContent = item.domain;
      text.append(title, meta);
      a.appendChild(text);

      li.appendChild(a);
      list.appendChild(li);
    }
  };

  const load = async () => {
    if (refresh) refresh.dataset.spinning = '';
    try {
      // Hacker News Algolia API — CORS-friendly, no auth, 30 latest front-page stories.
      const res = await fetch(
        `https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=${TARGET_COUNT}`,
        { cache: 'no-store' },
      );
      if (!res.ok) throw new Error('hn ' + res.status);
      const json = await res.json();
      const items: Story[] = (json?.hits ?? [])
        .filter((h: any) => h?.title)
        .map((h: any) => {
          const url = h.url || `https://news.ycombinator.com/item?id=${h.objectID}`;
          const host = safeDomain(url) || 'news.ycombinator.com';
          return {
            title: h.title as string,
            url,
            domain: host,
            faviconUrl: `https://www.google.com/s2/favicons?sz=64&domain=${host}`,
          };
        });
      if (!items.length) { setState('Could not load news.'); return; }
      renderItems(items);
    } catch (err) {
      console.error(err);
      setState('Could not load news.');
    } finally {
      if (refresh) delete refresh.dataset.spinning;
    }
  };

  load();
  refresh?.addEventListener('click', load);
</script>
