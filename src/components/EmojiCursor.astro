---
const EMOJIS = ['🦄', '🐰', '📷', '🤖', '🐠', '🪴'];
---
<script define:vars={{ EMOJIS }}>
  // Skip setup entirely on touch / small devices — the cursor is hidden
  // via CSS anyway, no need to burn cycles on the RAF + interval loops.
  if (matchMedia('(hover: none), (max-width: 760px)').matches) {
    // no-op
  } else {
  const cursor = document.createElement('div');
  cursor.className = 'cursor-emoji';
  const inner = document.createElement('span');
  inner.className = 'cursor-emoji-inner';
  inner.textContent = EMOJIS[0];
  cursor.append(inner);
  document.body.append(cursor);

  let mx = -100, my = -100, cx = -100, cy = -100;
  window.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
  (function loop() {
    cx += (mx - cx) * 0.22;
    cy += (my - cy) * 0.22;
    cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
    requestAnimationFrame(loop);
  })();

  let idx = 0;
  setInterval(() => {
    idx = (idx + 1) % EMOJIS.length;
    const out = inner.animate(
      [{ transform: 'translate(-50%,-50%) scale(1)', opacity: 1 },
       { transform: 'translate(-50%,-50%) scale(0.4)', opacity: 0 }],
      { duration: 180, easing: 'cubic-bezier(.6,0,.8,.4)', fill: 'forwards' },
    );
    out.onfinish = () => {
      inner.textContent = EMOJIS[idx];
      inner.animate(
        [{ transform: 'translate(-50%,-50%) scale(0.4)', opacity: 0 },
         { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 }],
        { duration: 240, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' },
      );
    };
  }, 1500);
  }
</script>

<style is:global>
  .cursor-emoji {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 100;
    width: 0;
    height: 0;
    will-change: transform;
  }
  .cursor-emoji-inner {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    font-size: 30px;
    line-height: 1;
    user-select: none;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.12));
  }
  @media (hover: none), (max-width: 760px) {
    .cursor-emoji { display: none; }
  }
</style>
