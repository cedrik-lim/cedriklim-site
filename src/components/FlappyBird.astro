---
---
<div class="flappy-bird" data-flappy aria-hidden="true">
  <img src="/flappy/midflap.png" alt="" data-flappy-img draggable="false" />
</div>

<style>
  .flappy-bird {
    position: absolute;
    top: 0;
    left: 0;
    line-height: 0;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    will-change: transform;
    transform: translate3d(-200px, -200px, 0);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18));
  }
  .flappy-bird img {
    display: block;
    width: 68px;
    height: 48px;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>

<script>
  const bird = document.querySelector<HTMLElement>('[data-flappy]');
  const img = document.querySelector<HTMLImageElement>('[data-flappy-img]');
  const hero = document.querySelector<HTMLElement>('.hero-name');
  const wall = document.querySelector<HTMLElement>('.hero-word');
  const FRAMES = ['/flappy/downflap.png', '/flappy/midflap.png', '/flappy/upflap.png', '/flappy/midflap.png'];
  let frameIdx = 1;
  let frameTick = 0;
  const BIRD_DISPLAY_W = 68;
  const BIRD_DISPLAY_H = 48;
  let feetY = BIRD_DISPLAY_H;
  const probe = new Image();
  probe.src = '/flappy/midflap.png';
  probe.onload = () => {
    const c = document.createElement('canvas');
    c.width = BIRD_DISPLAY_W;
    c.height = BIRD_DISPLAY_H;
    const cx = c.getContext('2d', { willReadFrequently: true });
    if (!cx) return;
    cx.imageSmoothingEnabled = false;
    cx.drawImage(probe, 0, 0, BIRD_DISPLAY_W, BIRD_DISPLAY_H);
    const d = cx.getImageData(0, 0, BIRD_DISPLAY_W, BIRD_DISPLAY_H).data;
    for (let yy = BIRD_DISPLAY_H - 1; yy >= 0; yy--) {
      let hit = false;
      for (let xx = 0; xx < BIRD_DISPLAY_W; xx++) {
        if (d[(yy * BIRD_DISPLAY_W + xx) * 4 + 3] > 40) { hit = true; break; }
      }
      if (hit) { feetY = yy + 1; break; }
    }
  };
  FRAMES.forEach((src) => { const i = new Image(); i.src = src; });
  if (bird && hero) {
    const BIRD_W = 68;
    const BIRD_H = 48;
    const GRAVITY = 0.45;
    const FLAP = -9;
    const DRIFT = 1.2;
    const MAX_VY = 12;

    let x = 80;
    let y = 0;
    let vy = 0;
    let landed = false;
    const heroRect = () => hero.getBoundingClientRect();

    // The "ground" is the text's baseline — the invisible line the
    // letters sit on. The bird renders BEHIND the text so it flies
    // past the letters and comes to rest on the baseline, like a
    // bird on a branch. This reads more naturally than sampling
    // per-letter silhouettes.
    let baselineY = Infinity;
    const computeBaseline = () => {
      if (!wall) { baselineY = Infinity; return; }
      const h = hero.getBoundingClientRect();
      const wr = wall.getBoundingClientRect();
      if (wr.width < 1) { baselineY = Infinity; return; }
      const cs = getComputedStyle(wall);
      const canvas = document.createElement('canvas');
      canvas.width = 1;
      canvas.height = 1;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      const m = ctx.measureText('Hg');
      // Distance from the top of the h1's rendered glyph box down to
      // the baseline. actualBoundingBoxAscent is measured from the
      // textBaseline origin; with default baseline 'alphabetic' that
      // equals the ascent above baseline.
      const ascent = m.actualBoundingBoxAscent;
      // The h1 box top aligns with the ascent top for this font-size
      // + line-height: 1 — same as the canvas metric.
      baselineY = wr.top - h.top + ascent;
    };

    const init = () => {
      const r = heroRect();
      y = r.height * 0.25;
    };
    init();

    if ((document as any).fonts?.ready) {
      (document as any).fonts.ready.then(() => computeBaseline());
    } else {
      computeBaseline();
    }

    const flap = () => {
      vy = FLAP;
      landed = false;
    };

    hero.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.scroll-arrow')) return;
      flap();
    });
    hero.style.cursor = 'pointer';

    let rafId = 0;
    let running = false;

    const step = () => {
      if (!running) return;
      const r = heroRect();

      if (!landed) {
        vy = Math.min(vy + GRAVITY, MAX_VY);
        const prevY = y;
        y += vy;
        x += DRIFT;

        if (x > r.width + BIRD_W) x = -BIRD_W;
        if (x < -BIRD_W) x = r.width + BIRD_W;

        // Land on the text's baseline (bird is behind the letters,
        // so visually it's sitting on the invisible line letters rest on)
        if (isFinite(baselineY) && vy > 0) {
          const prevBottom = prevY + feetY;
          const birdBottom = y + feetY;
          if (prevBottom <= baselineY && birdBottom >= baselineY) {
            y = baselineY - feetY;
            vy = 0;
            landed = true;
          }
        }

        // fallback ground — hero bottom
        if (!landed && y > r.height - feetY) {
          y = r.height - feetY;
          vy = 0;
          landed = true;
        }
        if (y < 0) {
          y = 0;
          vy = 1;
        }
      }

      const tilt = landed ? 0 : Math.max(-25, Math.min(70, vy * 5));
      bird.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${tilt}deg)`;

      if (img) {
        frameTick++;
        if (frameTick >= 6) {
          frameTick = 0;
          frameIdx = (frameIdx + 1) % FRAMES.length;
          img.src = FRAMES[frameIdx];
        }
      }

      rafId = requestAnimationFrame(step);
    };

    const start = () => {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(step);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && e.intersectionRatio > 0.3) start();
          else stop();
        }
      },
      { threshold: [0, 0.3, 1] },
    );
    io.observe(hero);

    window.addEventListener('resize', () => {
      const r = heroRect();
      if (x > r.width) x = r.width - BIRD_W;
      if (y > r.height - BIRD_H) y = r.height - BIRD_H;
      landed = false;
      computeBaseline();
    });
  }
</script>
