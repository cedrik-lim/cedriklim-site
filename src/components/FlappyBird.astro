---
---
<div class="flappy-bird" data-flappy aria-hidden="true">
  <img src="/flappy/midflap.png" alt="" data-flappy-img draggable="false" />
</div>

<style>
  .flappy-bird {
    position: absolute;
    top: 0;
    left: 0;
    line-height: 0;
    pointer-events: none;
    user-select: none;
    z-index: 5;
    will-change: transform;
    transform: translate3d(-200px, -200px, 0);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18));
  }
  .flappy-bird img {
    display: block;
    width: 68px;
    height: 48px;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>

<script>
  const bird = document.querySelector<HTMLElement>('[data-flappy]');
  const img = document.querySelector<HTMLImageElement>('[data-flappy-img]');
  const hero = document.querySelector<HTMLElement>('.hero-name');
  const wall = document.querySelector<HTMLElement>('.hero-word');
  const FRAMES = ['/flappy/downflap.png', '/flappy/midflap.png', '/flappy/upflap.png', '/flappy/midflap.png'];
  let frameIdx = 1;
  let frameTick = 0;
  // Bird displayed size (must match CSS)
  const BIRD_DISPLAY_W = 68;
  const BIRD_DISPLAY_H = 48;
  // Auto-detected feet offset from top of sprite (transparent bottom padding trimmed)
  let feetY = BIRD_DISPLAY_H;
  const probe = new Image();
  probe.src = '/flappy/midflap.png';
  probe.onload = () => {
    const c = document.createElement('canvas');
    c.width = BIRD_DISPLAY_W;
    c.height = BIRD_DISPLAY_H;
    const cx = c.getContext('2d', { willReadFrequently: true });
    if (!cx) return;
    cx.imageSmoothingEnabled = false;
    cx.drawImage(probe, 0, 0, BIRD_DISPLAY_W, BIRD_DISPLAY_H);
    const d = cx.getImageData(0, 0, BIRD_DISPLAY_W, BIRD_DISPLAY_H).data;
    for (let yy = BIRD_DISPLAY_H - 1; yy >= 0; yy--) {
      let hit = false;
      for (let xx = 0; xx < BIRD_DISPLAY_W; xx++) {
        if (d[(yy * BIRD_DISPLAY_W + xx) * 4 + 3] > 40) { hit = true; break; }
      }
      if (hit) { feetY = yy + 1; break; }
    }
  };
  FRAMES.forEach((src) => { const i = new Image(); i.src = src; });
  if (bird && hero) {
    const BIRD_W = 68;
    const BIRD_H = 48;
    const GRAVITY = 0.45;
    const FLAP = -9;
    const DRIFT = 1.2;
    const MAX_VY = 12;

    let x = 80;
    let y = 0;
    let vy = 0;
    let landed = false;
    const heroRect = () => hero.getBoundingClientRect();

    // Pixel silhouette of the text so the bird sinks into the crevasses
    // between letters instead of resting on a flat bounding box.
    let heightmap: Float32Array | null = null;
    let mapLeft = 0;
    let mapTop = 0;
    const MAP_PAD = 8;

    const buildHeightmap = () => {
      if (!wall) return;
      const typed = wall.querySelector<HTMLElement>('.hero-typed');
      const text = typed?.textContent ?? '';
      if (!typed || !text) { heightmap = null; return; }

      const h = hero.getBoundingClientRect();
      const wr = typed.getBoundingClientRect();
      if (wr.width < 1 || wr.height < 1) { heightmap = null; return; }

      const cs = getComputedStyle(wall);
      const canvas = document.createElement('canvas');
      canvas.width = Math.ceil(wr.width) + MAP_PAD * 2;
      canvas.height = Math.ceil(wr.height) + MAP_PAD * 2;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      ctx.textBaseline = 'top';
      ctx.fillStyle = '#000';
      ctx.fillText(text, MAP_PAD, MAP_PAD);

      const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      const hm = new Float32Array(canvas.width);
      for (let sx = 0; sx < canvas.width; sx++) {
        let foundY = Infinity;
        for (let sy = 0; sy < canvas.height; sy++) {
          if (data[(sy * canvas.width + sx) * 4 + 3] > 40) {
            foundY = sy;
            break;
          }
        }
        hm[sx] = foundY;
      }
      heightmap = hm;
      mapLeft = wr.left - h.left - MAP_PAD;
      mapTop = wr.top - h.top - MAP_PAD;
    };

    const init = () => {
      const r = heroRect();
      y = r.height * 0.25;
    };
    init();

    if ((document as any).fonts?.ready) {
      (document as any).fonts.ready.then(() => buildHeightmap());
    } else {
      buildHeightmap();
    }
    const typedEl = wall?.querySelector('.hero-typed');
    if (typedEl) {
      new MutationObserver(() => buildHeightmap()).observe(typedEl, {
        childList: true,
        characterData: true,
        subtree: true,
      });
    }

    const flap = () => {
      vy = FLAP;
      landed = false;
    };

    hero.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.scroll-arrow')) return;
      flap();
    });
    hero.style.cursor = 'pointer';

    let rafId = 0;
    let running = false;

    const step = () => {
      if (!running) return;
      const r = heroRect();

      if (!landed) {
        vy = Math.min(vy + GRAVITY, MAX_VY);
        const prevY = y;
        y += vy;
        x += DRIFT;

        if (x > r.width + BIRD_W) x = -BIRD_W;
        if (x < -BIRD_W) x = r.width + BIRD_W;

        // Sample text silhouette under the bird's feet so it sinks
        // into crevasses between letters.
        if (heightmap && vy > 0) {
          const birdBottom = y + feetY;
          const prevBottom = prevY + feetY;
          const feetCenter = x + BIRD_W / 2 - mapLeft;
          const SAMPLE = 10;
          let topY = Infinity;
          for (let sx = Math.floor(feetCenter - SAMPLE); sx <= Math.ceil(feetCenter + SAMPLE); sx++) {
            if (sx < 0 || sx >= heightmap.length) continue;
            const v = heightmap[sx];
            if (v < topY) topY = v;
          }
          if (isFinite(topY)) {
            const groundY = mapTop + topY;
            if (prevBottom <= groundY && birdBottom >= groundY) {
              y = groundY - feetY;
              vy = 0;
              landed = true;
            }
          }
        }

        // ground — hero bottom
        if (!landed && y > r.height - feetY) {
          y = r.height - feetY;
          vy = 0;
          landed = true;
        }
        if (y < 0) {
          y = 0;
          vy = 1;
        }
      }

      const tilt = landed ? 0 : Math.max(-25, Math.min(70, vy * 5));
      bird.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${tilt}deg)`;

      // wing-flap sprite cycle: down → mid → up → mid
      if (img) {
        frameTick++;
        if (frameTick >= 6) {
          frameTick = 0;
          frameIdx = (frameIdx + 1) % FRAMES.length;
          img.src = FRAMES[frameIdx];
        }
      }

      rafId = requestAnimationFrame(step);
    };

    const start = () => {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(step);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && e.intersectionRatio > 0.3) start();
          else stop();
        }
      },
      { threshold: [0, 0.3, 1] },
    );
    io.observe(hero);

    window.addEventListener('resize', () => {
      const r = heroRect();
      if (x > r.width) x = r.width - BIRD_W;
      if (y > r.height - BIRD_H) y = r.height - BIRD_H;
      landed = false;
      buildHeightmap();
    });
  }
</script>
