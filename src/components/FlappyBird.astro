---
---
<div class="flappy-bird" data-flappy aria-hidden="true">
  <img src="/flappy/midflap.png" alt="" data-flappy-img draggable="false" />
</div>

<style>
  .flappy-bird {
    position: absolute;
    top: 0;
    left: 0;
    line-height: 0;
    pointer-events: none;
    user-select: none;
    z-index: 5;
    will-change: transform;
    transform: translate3d(-200px, -200px, 0);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18));
  }
  .flappy-bird img {
    display: block;
    width: 68px;
    height: 48px;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>

<script>
  const bird = document.querySelector<HTMLElement>('[data-flappy]');
  const img = document.querySelector<HTMLImageElement>('[data-flappy-img]');
  const hero = document.querySelector<HTMLElement>('.hero-name');
  const wall = document.querySelector<HTMLElement>('.hero-word');
  const FRAMES = ['/flappy/downflap.png', '/flappy/midflap.png', '/flappy/upflap.png', '/flappy/midflap.png'];
  let frameIdx = 1;
  let frameTick = 0;
  FRAMES.forEach((src) => { const i = new Image(); i.src = src; });
  if (bird && hero) {
    const BIRD_W = 68;
    const BIRD_H = 48;
    const GRAVITY = 0.45;
    const FLAP = -9;
    const DRIFT = 1.2;
    const MAX_VY = 12;

    let x = 80;
    let y = 0;
    let vy = 0;
    let landed = false;
    const heroRect = () => hero.getBoundingClientRect();
    const wallRect = () => {
      if (!wall) return null;
      const h = hero.getBoundingClientRect();
      const w = wall.getBoundingClientRect();
      return {
        left: w.left - h.left,
        right: w.right - h.left,
        top: w.top - h.top,
      };
    };

    const init = () => {
      const r = heroRect();
      y = r.height * 0.25;
    };
    init();

    const flap = () => {
      vy = FLAP;
      landed = false;
    };

    hero.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.scroll-arrow')) return;
      flap();
    });
    hero.style.cursor = 'pointer';

    let rafId = 0;
    let running = false;

    const step = () => {
      if (!running) return;
      const r = heroRect();

      if (!landed) {
        vy = Math.min(vy + GRAVITY, MAX_VY);
        const prevY = y;
        y += vy;
        x += DRIFT;

        if (x > r.width + BIRD_W) x = -BIRD_W;
        if (x < -BIRD_W) x = r.width + BIRD_W;

        // name acts as a wall — land on top of it
        const w = wallRect();
        if (w && vy > 0) {
          const birdRight = x + BIRD_W;
          const birdBottom = y + BIRD_H;
          const prevBottom = prevY + BIRD_H;
          const overlapsX = birdRight > w.left + 4 && x < w.right - 4;
          if (overlapsX && prevBottom <= w.top && birdBottom >= w.top) {
            y = w.top - BIRD_H;
            vy = 0;
            landed = true;
          }
        }

        // ground — hero bottom
        if (!landed && y > r.height - BIRD_H) {
          y = r.height - BIRD_H;
          vy = 0;
          landed = true;
        }
        if (y < 0) {
          y = 0;
          vy = 1;
        }
      }

      const tilt = landed ? 0 : Math.max(-25, Math.min(70, vy * 5));
      bird.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${tilt}deg)`;

      // wing-flap sprite cycle: down → mid → up → mid
      if (img) {
        frameTick++;
        if (frameTick >= 6) {
          frameTick = 0;
          frameIdx = (frameIdx + 1) % FRAMES.length;
          img.src = FRAMES[frameIdx];
        }
      }

      rafId = requestAnimationFrame(step);
    };

    const start = () => {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(step);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && e.intersectionRatio > 0.3) start();
          else stop();
        }
      },
      { threshold: [0, 0.3, 1] },
    );
    io.observe(hero);

    window.addEventListener('resize', () => {
      const r = heroRect();
      if (x > r.width) x = r.width - BIRD_W;
      if (y > r.height - BIRD_H) y = r.height - BIRD_H;
      landed = false;
    });
  }
</script>
