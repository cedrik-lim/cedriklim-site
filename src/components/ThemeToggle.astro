---
---
<button class="theme-toggle" aria-label="Toggle theme" data-theme-toggle>
  <svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <line x1="12" y1="2" x2="12" y2="4"></line>
    <line x1="12" y1="20" x2="12" y2="22"></line>
    <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line>
    <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line>
    <line x1="2" y1="12" x2="4" y2="12"></line>
    <line x1="20" y1="12" x2="22" y2="12"></line>
    <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line>
    <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line>
  </svg>
  <svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: max(20px, env(safe-area-inset-top));
    right: max(20px, env(safe-area-inset-right));
    z-index: 50;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  @media (max-width: 640px) {
    .theme-toggle { width: 40px; height: 40px; }
  }
  .theme-icon {
    position: absolute;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(.2,.8,.2,1);
  }
  .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .theme-icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  html[data-theme="dark"] .theme-icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  html[data-theme="dark"] .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
