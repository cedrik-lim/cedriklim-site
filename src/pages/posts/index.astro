---
import Base from '../../layouts/Base.astro';
---
<Base title="Writings — Cedrik Lim">
  <main class="min-h-[100svh] bg-bg px-8 py-16">
    <a href="/" class="back-link" aria-label="Home">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 6 9 12 15 18"></polyline>
      </svg>
    </a>

    <section class="mx-auto mt-24 max-w-[760px] text-center text-ink">
      <h1 class="serif heading">Writings.</h1>
      <p class="mt-6 italic text-ink/60 text-[17px]">A journal. Nothing here yet.</p>
    </section>
  </main>
</Base>

<style>
  .back-link {
    position: fixed;
    top: max(20px, env(safe-area-inset-top));
    left: max(20px, env(safe-area-inset-left));
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .back-link:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  @media (max-width: 640px) {
    .back-link { width: 44px; height: 44px; }
  }

  .heading {
    font-weight: 500;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
</style>
