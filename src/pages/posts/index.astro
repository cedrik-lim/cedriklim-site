---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Writings — Cedrik Lim">
  <main class="posts-main">
    <a href="/" class="back-link" aria-label="Home">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 6 9 12 15 18"></polyline>
      </svg>
    </a>

    <header class="page-head">
      <h1 class="serif page-title">Writings.</h1>
      <p class="page-sub italic">A journal.</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty italic">Nothing here yet.</p>
    ) : (
      <section class="grid" aria-label="Posts">
        {posts.map((post) => (
          <a href={`/posts/${post.id}`} class="card">
            <div class="card-media">
              <img src={post.data.cover} alt="" loading="lazy" />
            </div>
            <div class="card-text">
              <h2 class="serif card-title">{post.data.title}</h2>
              <time class="card-date" datetime={post.data.date.toISOString()}>
                {fmt(post.data.date)}
              </time>
            </div>
          </a>
        ))}
      </section>
    )}
  </main>
</Base>

<style>
  .posts-main {
    min-height: 100svh;
    background: var(--color-bg);
    padding: clamp(80px, 10vw, 140px) clamp(24px, 5vw, 80px) 120px;
  }

  .back-link {
    position: fixed;
    top: max(20px, env(safe-area-inset-top));
    left: max(20px, env(safe-area-inset-left));
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
    z-index: 40;
  }
  .back-link:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  @media (max-width: 640px) {
    .back-link { width: 44px; height: 44px; }
  }

  .page-head {
    max-width: 1120px;
    margin: 0 auto clamp(56px, 7vw, 96px);
    text-align: center;
    color: var(--color-ink);
  }
  .page-title {
    font-weight: 500;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .page-sub {
    margin: 1em 0 0;
    font-size: clamp(16px, 1.4vw, 20px);
    opacity: 0.55;
  }

  .empty {
    max-width: 1120px;
    margin: 0 auto;
    text-align: center;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    font-size: 18px;
  }

  .grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: clamp(32px, 4vw, 72px);
    row-gap: clamp(56px, 6vw, 96px);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      row-gap: 56px;
    }
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
  }
  .card-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(.2,.8,.2,1);
  }
  .card:hover .card-media img {
    transform: scale(1.03);
  }
  .card-text {
    margin-top: 20px;
  }
  .card-title {
    font-weight: 500;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
    transition: opacity 0.25s ease;
  }
  .card:hover .card-title {
    opacity: 0.7;
  }
  .card-date {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.45;
  }
</style>
