---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={`${post.data.title} — Cedrik Lim`} description={post.data.excerpt}>
  <main class="post-main">
    <a href="/posts" class="back-link" aria-label="Back to Writings">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 6 9 12 15 18"></polyline>
      </svg>
    </a>

    <article>
      <header class="post-head">
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {fmt(post.data.date)}
        </time>
        <h1 class="serif post-title">{post.data.title}</h1>
        {post.data.excerpt && <p class="post-excerpt italic">{post.data.excerpt}</p>}
      </header>

      <figure class="post-cover">
        <img src={post.data.cover} alt="" />
      </figure>

      <div class="post-body">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .post-main {
    min-height: 100svh;
    background: var(--color-bg);
    color: var(--color-ink);
    padding: clamp(80px, 10vw, 140px) clamp(24px, 5vw, 48px) 160px;
  }

  .back-link {
    position: fixed;
    top: max(20px, env(safe-area-inset-top));
    left: max(20px, env(safe-area-inset-left));
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
    z-index: 40;
  }
  .back-link:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  @media (max-width: 640px) {
    .back-link { width: 44px; height: 44px; }
  }

  .post-head {
    max-width: 680px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
  }
  .post-date {
    display: block;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .post-title {
    margin: 0.5em 0 0;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .post-excerpt {
    margin: 1em 0 0;
    font-size: clamp(18px, 1.6vw, 22px);
    opacity: 0.6;
  }

  .post-cover {
    max-width: 1120px;
    margin: 0 auto clamp(48px, 6vw, 80px);
    padding: 0;
  }
  .post-cover img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
  }

  .post-body {
    max-width: 680px;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.3vw, 21px);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }
  .post-body :global(p) { margin: 0 0 1.4em; }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.8em;
    padding-left: 1.4em;
  }
  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(li) {
    margin: 0 0 0.5em;
    padding-left: 0.25em;
  }
  .post-body :global(li::marker) {
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .post-body :global(h2) {
    font-weight: 500;
    font-size: 1.5em;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 2em 0 0.6em;
    color: var(--color-ink);
  }
  .post-body :global(h3) {
    font-weight: 500;
    font-size: 1.2em;
    margin: 1.8em 0 0.5em;
    color: var(--color-ink);
  }
  .post-body :global(a) {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.25s ease;
  }
  .post-body :global(a:hover) { opacity: 0.6; }
  .post-body :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 1.2em;
    border-left: 2px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    font-style: italic;
    opacity: 0.85;
  }
  .post-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.6em auto;
    border-radius: 6px;
  }
  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .post-body :global(pre) {
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    padding: 1em 1.2em;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.6em 0;
  }
  .post-body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .post-body :global(hr) {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    margin: 3em auto;
    width: 60px;
  }
</style>
